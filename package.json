{
  "name": "RNStarter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "start:staging": "APP_ENV=staging react-native start --reset-cache",
    "pods": "cd ios && bundle exec pod install",
    "pods:update": "cd ios && bundle exec pod install --repo-update",
    "link-assets": "react-native-asset",
    "bootsplash": "react-native-bootsplash generate src/assets/brand/logo.svg --platforms=android,ios --background=FFFFFF --logo-width=96 --assets-output=src/assets/bootsplash",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "maestro test --test-output-dir .maestro-output maestro/",
    "verify": "npm run typecheck && npm run lint && npm test",
    "clean:android": "cd android && ./gradlew clean",
    "clean:ios": "rm -rf ios/build ios/Pods && npm run pods",
    "clean:metro": "rm -rf $TMPDIR/metro-* $TMPDIR/haste-map-*",
    "postinstall": "patch-package",
    "patch:nitro": "patch-package react-native-nitro-modules --exclude '^package\\.json$|android/\\.cxx/|android/build/|\\.gradle/'",
    "patch:css-interop": "patch-package react-native-css-interop --exclude '^package\\.json$|^\\.cache/|android/|ios/'",
    "prepare": "husky"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "~5.2.14",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/react-query": "^5.103.1",
    "axios": "1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.2",
    "intl-pluralrules": "^2.0.1",
    "lucide-react-native": "^1.47.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "react-native": "0.87.1",
    "react-native-bootsplash": "^7.3.3",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "~1.22.5",
    "react-native-keychain": "^10.0.0",
    "react-native-localize": "^3.7.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "~4.6.0",
    "react-native-responsive-screen": "^1.4.2",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.12.2",
    "react-redux": "^9.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^17.5.1",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-native-asset": "^2.3.0",
    "react-native-dotenv": "^4.1.1",
    "tailwindcss": "^3.4.19",
    "test-renderer": "~1.2.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.22.1"
  }
}
