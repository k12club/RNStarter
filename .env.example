# คัดลอกเป็น .env แล้วแก้ค่า (ไฟล์ .env ไม่ถูก commit)
# ค่าทั้งหมดถูกฝังลง JS bundle ตอน build: ห้ามใส่ secret
# แก้ค่าแล้วต้องรัน `npm start -- --reset-cache` ใหม่ ไม่งั้น Metro ใช้ค่าเก่าจาก cache
# ไฟล์ .env.<โหมด> ทับค่าในไฟล์นี้: build release อ่าน .env.production, `npm run start:staging` อ่าน .env.staging

# development | staging | production
APP_ENV=development

# Base URL ของ API (ค่าเริ่มต้นเป็น DummyJSON สำหรับ demo)
API_URL=https://dummyjson.com

# Timeout ของ request (ms)
API_TIMEOUT_MS=15000

# แสดง log ของ request/response ใน console (true/false)
ENABLE_API_LOG=true
